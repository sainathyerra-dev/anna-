# Copy this file to ".env" and paste your real key in.
# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: change the port the server runs on
PORT=3000

# For hosting: NODE_ENV=production and a private password of 16+ characters.
# Enter the actual password in Render settings, never in source control.
APP_PASSWORD=

# Free Render: browser. Local computer or paid persistent disk: file.
STORAGE_MODE=file
# For hosted file storage, point DATA_DIR to the persistent disk mount.
# DATA_DIR=/var/data/anna
# ANTHROPIC_MODEL=claude-sonnet-4-6
